      "supportsTablet": true,
      "bundleIdentifier": "com.tinytracker.mobile",
      "buildNumber": "53",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "GADNativeAdValidatorEnabled": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Helps us understand how you discovered Tiny Tracker so we can reach more parents like you."
      }
    },
