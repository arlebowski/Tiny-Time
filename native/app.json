{
  "expo": {
    "name": "Tiny Tracker",
    "slug": "native",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/lockup-lt.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EB"
    },
